function [hasil, mask] = deteksiwarna(I, warna)    % Konversi ke double    I = im2double(I);        % Ambil channel RGB    R = I(:,:,1);    G = I(:,:,2);    B = I(:,:,3);    switch warna        case 'R'            mask = (R > 0.4) & (R > G) & (R > B);        case 'G'            mask = (G > 0.4) & (G > R) & (G > B);        case 'B'            mask = (B > 0.4) & (B > R) & (B > G);        otherwise            error('Warna tidak dikenali. Gunakan R, G, atau B');    end        % Buat citra hasil    hasil = bsxfun(@times, I, cast(mask, 'like', I));end